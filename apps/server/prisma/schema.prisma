generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COMMERCIAL
  PRODUCTION
  FINANCE
  STOCK
}
enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}
enum OrderStatus {
  NEW
  WAITING_ART
  READY_PRODUCTION
  IN_PRODUCTION
  FINISHING
  QUALITY
  READY
  DELIVERED
  CANCELLED
}
enum ProductionStatus {
  PENDING
  IN_PROGRESS
  PAUSED
  DONE
  REWORK
}
enum AccountStatus {
  OPEN
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}
enum StockMovementType {
  PURCHASE_IN
  PURCHASE_OUT
  SALE_OUT
  PRODUCTION_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}
enum PurchaseStatus {
  DRAFT
  REQUESTED
  APPROVED
  ORDERED
  RECEIVED
  CANCELLED
}
enum ArtworkStatus {
  PENDING
  APPROVAL
  APPROVED
  CHANGES_REQUESTED
}

model Tenant {
  id String @id @default(cuid())
  name String
  document String? @unique
  createdAt DateTime @default(now())
  users User[]
  customers Customer[]
  products Product[]
  quotes Quote[]
  orders Order[]
  suppliers Supplier[]
  stockItems StockItem[]
  stockMovements StockMovement[]
  purchases Purchase[]
  accountsReceivable AccountReceivable[]
  accountsPayable AccountPayable[]
  productionOrders ProductionOrder[]
  artworks Artwork[]
}

model User {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  name String
  email String
  passwordHash String
  role UserRole @default(COMMERCIAL)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  @@unique([tenantId,email])
  @@index([tenantId])
}

model Customer {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  name String
  document String?
  email String?
  phone String?
  address String?
  city String?
  state String?
  active Boolean @default(true)
  portalEnabled Boolean @default(true)
  portalPasswordHash String?
  createdAt DateTime @default(now())
  quotes Quote[]
  orders Order[]
  artworks Artwork[]
  accountsReceivable AccountReceivable[]
  @@index([tenantId])
}

model Product {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  code String
  name String
  description String?
  unit String @default("UN")
  cost Decimal @db.Decimal(12,2)
  price Decimal @db.Decimal(12,2)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  quoteItems QuoteItem[]
  orderItems OrderItem[]
  stockItem StockItem?
  stockMovements StockMovement[]
  purchaseItems PurchaseItem[]
  productionOrders ProductionOrder[]
  @@unique([tenantId,code])
  @@index([tenantId])
}

model Quote {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  customerId String
  customer Customer @relation(fields:[customerId], references:[id])
  number Int
  status QuoteStatus @default(DRAFT)
  validUntil DateTime?
  discount Decimal @default(0) @db.Decimal(12,2)
  total Decimal @db.Decimal(12,2)
  notes String?
  createdAt DateTime @default(now())
  items QuoteItem[]
  order Order?
  @@unique([tenantId,number])
  @@index([tenantId])
}
model QuoteItem {
  id String @id @default(cuid())
  quoteId String
  quote Quote @relation(fields:[quoteId], references:[id], onDelete: Cascade)
  productId String
  product Product @relation(fields:[productId], references:[id])
  quantity Decimal @db.Decimal(12,3)
  unitPrice Decimal @db.Decimal(12,2)
  subtotal Decimal @db.Decimal(12,2)
}

model Order {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  customerId String
  customer Customer @relation(fields:[customerId], references:[id])
  quoteId String? @unique
  quote Quote? @relation(fields:[quoteId], references:[id])
  number Int
  status OrderStatus @default(NEW)
  total Decimal @db.Decimal(12,2)
  dueDate DateTime?
  notes String?
  createdAt DateTime @default(now())
  items OrderItem[]
  productionOrders ProductionOrder[]
  artworks Artwork[]
  accountsReceivable AccountReceivable[]
  @@unique([tenantId,number])
  @@index([tenantId])
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId], references:[id], onDelete: Cascade)
  productId String
  product Product @relation(fields:[productId], references:[id])
  quantity Decimal @db.Decimal(12,3)
  unitPrice Decimal @db.Decimal(12,2)
  subtotal Decimal @db.Decimal(12,2)
}

model Artwork {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  customerId String
  customer Customer @relation(fields:[customerId], references:[id])
  orderId String?
  order Order? @relation(fields:[orderId], references:[id])
  fileName String
  fileUrl String
  status ArtworkStatus @default(PENDING)
  version Int @default(1)
  comment String?
  createdAt DateTime @default(now())
  @@index([tenantId])
}

model ProductionOrder {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  orderId String
  order Order @relation(fields:[orderId], references:[id], onDelete: Cascade)
  productId String
  product Product @relation(fields:[productId], references:[id])
  number Int
  status ProductionStatus @default(PENDING)
  quantity Decimal @db.Decimal(12,3)
  produced Decimal @default(0) @db.Decimal(12,3)
  waste Decimal @default(0) @db.Decimal(12,3)
  startedAt DateTime?
  finishedAt DateTime?
  notes String?
  createdAt DateTime @default(now())
  @@unique([tenantId,number])
  @@index([tenantId])
}

model StockItem {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  productId String @unique
  product Product @relation(fields:[productId], references:[id], onDelete: Cascade)
  quantity Decimal @default(0) @db.Decimal(12,3)
  minimum Decimal @default(0) @db.Decimal(12,3)
  location String?
}

model StockMovement {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  productId String
  product Product @relation(fields:[productId], references:[id])
  type StockMovementType
  quantity Decimal @db.Decimal(12,3)
  reason String?
  referenceId String?
  createdAt DateTime @default(now())
  @@index([tenantId,productId])
}

model Supplier {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  name String
  document String?
  email String?
  phone String?
  address String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  purchases Purchase[]
  accountsPayable AccountPayable[]
}

model Purchase {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  supplierId String
  supplier Supplier @relation(fields:[supplierId], references:[id])
  number Int
  status PurchaseStatus @default(DRAFT)
  total Decimal @default(0) @db.Decimal(12,2)
  dueDate DateTime?
  notes String?
  createdAt DateTime @default(now())
  items PurchaseItem[]
  accountsPayable AccountPayable?
  @@unique([tenantId,number])
}
model PurchaseItem {
  id String @id @default(cuid())
  purchaseId String
  purchase Purchase @relation(fields:[purchaseId], references:[id], onDelete: Cascade)
  productId String
  product Product @relation(fields:[productId], references:[id])
  quantity Decimal @db.Decimal(12,3)
  unitCost Decimal @db.Decimal(12,2)
  subtotal Decimal @db.Decimal(12,2)
}

model AccountReceivable {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  customerId String
  customer Customer @relation(fields:[customerId], references:[id])
  orderId String?
  order Order? @relation(fields:[orderId], references:[id])
  description String
  amount Decimal @db.Decimal(12,2)
  paidAmount Decimal @default(0) @db.Decimal(12,2)
  dueDate DateTime
  paidAt DateTime?
  status AccountStatus @default(OPEN)
  createdAt DateTime @default(now())
  @@index([tenantId,status])
}

model AccountPayable {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  supplierId String
  supplier Supplier @relation(fields:[supplierId], references:[id])
  purchaseId String? @unique
  purchase Purchase? @relation(fields:[purchaseId], references:[id])
  description String
  amount Decimal @db.Decimal(12,2)
  paidAmount Decimal @default(0) @db.Decimal(12,2)
  dueDate DateTime
  paidAt DateTime?
  status AccountStatus @default(OPEN)
  createdAt DateTime @default(now())
  @@index([tenantId,status])
}
