{
  "name": "grafica-saas",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm --prefix apps/server run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "build": "npm run build:server && npm run build:web",
    "build:server": "npm --prefix apps/server run build",
    "build:web": "npm --prefix apps/web run build",
    "db:push": "npm --prefix apps/server run db:push",
    "db:seed": "npm --prefix apps/server run db:seed",
    "check": "npm run build",
    "start": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
